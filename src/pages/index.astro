---
import { BentoGrid, BentoGridItem } from "@/components/BentoGrid";
import { SkillGrid } from "@/components/SkillCarousel";
import { Separator } from "@/components/ui/separator";
// import { interests } from "@/constants/interest";
import { skillCategories } from "@/constant/skills";
import Layout from "../layouts/Layout.astro";

const selfIntro =
  "Hi there, I am Veacodes.\n I enjoy writing Python and Typescript. I am interested in AI/ML technologies and software development.";
---

<Layout title="Veacodes">
  <section>
    <h3 class="scroll-m-20 text-2xl font-semibold tracking-tight">About me</h3>
    <p class="scroll-m-20 text-lg font-semibold tracking-tight">
      {selfIntro}
    </p>
  </section>
  <Separator />
  <section class="w-full">
    <h3 class="scroll-m-20 text-2xl font-semibold tracking-tight mb-2">
      Tools and Technologies
    </h3>
    {skillCategories.map((category) => (
      <div class="mb-8">
        <h4 class="scroll-m-20 text-xl font-medium tracking-tight mb-4 text-muted-foreground">
          {category.title}
        </h4>
        <SkillGrid
          client:load
          skills={category.skills}
          rowSize={6}
          rowsDelay={150}
          class="flex flex-col gap-6"
        />
      </div>
    ))}
  </section>
  <!-- <Separator /> -->
  <!-- <section> -->
    <!-- <h3 class="scroll-m-20 text-2xl font-semibold tracking-tight">
      My Interests
    </h3> -->

    <!-- <BentoGrid class="mt-6">
      {interests.map((int) => <BentoGridItem {...int} />)}
    </BentoGrid> -->
  <!-- </section> -->
</Layout>